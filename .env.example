# Template das variáveis de ambiente. Copie para .env (ignorado pelo git) e
# injete no ambiente de execução das funções (ex.: set -a; source .env; set +a
# antes do deploy). A aplicação lê só System.getenv — nenhum arquivo é carregado.

# --- API ---------------------------------------------------------------------
# URL pública da API; é injetada no config.json servido ao Journey Builder
BASE_URL=https://sua-api.exemplo.com

# JWT Signing Secret do Installed Package (SFMC). Mínimo 32 caracteres (HS256)
JWT_SECRET=

# --- API + worker -------------------------------------------------------------
# URL da fila FIFO. Vazio = a API processa inline (modo dev, sem fila)
QUEUE_URL=

# true loga o payload completo (contém PII). Só para inspeção
DEBUG_PAYLOAD=false

# --- worker (opcional) --------------------------------------------------------
# Credenciais de um Installed Package com permissão de leitura em Journeys.
# Habilitam o lookup do nome atual da jornada (à prova de renomeação).
SFMC_AUTH_URL=https://SEU_SUBDOMINIO.auth.marketingcloudapis.com
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=
